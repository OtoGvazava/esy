# Copy to .env (gitignored) and fill in. docker-compose.yml reads these
# automatically — then just `docker compose up`, no command prefix.
#
#   cp .env.example .env   &&  edit .env  &&  docker compose up -d

# Google OAuth (real "Continue with Gmail"). Create a Web-application OAuth
# client in Google Cloud Console and add ALL redirect URIs you will use:
#   http://lvh.me:8092/login/oauth2/code/google   ← lvh.me local dev
#   https://www.esy.ge/login/oauth2/code/google      ← prod
# Leave blank to keep Gmail inert (email dev-login still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The single canonical OAuth host — all tenant subdomains funnel here so only
# one redirect URI is registered with Google (no wildcards in OAuth).
# lvh.me dev  → http://lvh.me:8092
# Prod           → https://www.esy.ge
# Leave unset for bare-localhost / Vite dev (no subdomains there).
APP_OAUTH2_CANONICAL_ORIGIN=

# ── Payments (Bank of Georgia) ───────────────────────────────────────────────
# Per-store credentials are entered by each owner in Store Settings (encrypted
# at rest). These are platform-wide knobs.

# Encrypts every store's BOG client secret in the DB. Set to a long random
# string in prod. Changing it makes existing stored secrets undecryptable
# (stores must re-enter their BOG credentials), so set it once and keep it.
APP_SECRET_ENC_KEY=

# Origin BOG redirects/calls back to. Leave blank locally (BOG can't reach
# lvh.me; the return page reconciles via the receipt API). Prod → https://www.esy.ge
APP_PUBLIC_BASE_URL=

# BOG's callback-signing public key — the PEM from
# https://api.bog.ge/docs/en/payments/callback (paste it on ONE line; the
# BEGIN/END lines and whitespace are stripped automatically). Leave blank
# locally to skip signature checks; REQUIRED in prod so callbacks are
# authenticated. Override BOG_BASE_URL/BOG_AUTH_URL only for sandbox testing.
BOG_PUBLIC_KEY=
#BOG_BASE_URL=https://api.bog.ge
#BOG_AUTH_URL=https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token
