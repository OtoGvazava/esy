# Copy to .env (gitignored) and fill in. docker-compose.yml reads these
# automatically — then just `docker compose up`, no command prefix.
#
#   cp .env.example .env   &&  edit .env  &&  docker compose up -d

# Google OAuth (real "Continue with Gmail"). Create a Web-application OAuth
# client in Google Cloud Console; Authorized redirect URI must be exactly:
#   http://localhost:8092/login/oauth2/code/google
# Leave blank to keep Gmail inert (email dev-login still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Prod only — the single canonical OAuth host for wildcard tenants.
# MUST stay unset on localhost (setting it enables the cross-host funnel
# and breaks local sign-in). Example for prod: https://www.esy.ge
# APP_OAUTH2_CANONICAL_ORIGIN=
