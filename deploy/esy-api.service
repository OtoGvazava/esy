[Unit]
Description=esy Spring Boot API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=esy
Group=esy
# Env (JWT_SECRET, SPRING_DATASOURCE_URL=file mode, JPA_DDL_AUTO=update, etc.)
EnvironmentFile=/etc/esy/esy-api.env
ExecStart=/usr/bin/java -jar /opt/esy/esy-api.jar
WorkingDirectory=/var/lib/esy
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/esy

[Install]
WantedBy=multi-user.target
