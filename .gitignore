# OS
.DS_Store

# IDE / local tooling (machine-specific)
.idea/
.vscode/
# .claude/* (not .claude/) so the negations below can re-include entries —
# git cannot un-ignore anything inside an excluded *directory*. Shared with the
# team: slash commands, project hooks, and the settings.json that wires them.
# Machine-local (still ignored): settings.local.json, statusline.js,
# .miro-sync-state.
.claude/*
!.claude/commands/
!.claude/hooks/
!.claude/settings.json
# The Miro board's editing rules — referenced by the stop hook, so it has to
# travel with the hook rather than being per-machine.
!.claude/miro-board-rules.md

# Node / Vite (apps/web)
node_modules/
apps/web/dist/
apps/web/.vite/
*.local

# Java / Maven (apps/api)
apps/api/target/
*.class

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# design-sync (claude.ai/design) — staged scripts + build output + machine state.
# Kept: .design-sync/config.json, NOTES.md, conventions.md, previews/, and the
# apps/web/.ds-entry.mjs / .ds-provider.jsx sync inputs.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
